<Themes>
  <!-- Focus Signal
       The restrained option. A neutral grey-black ground, one orange-red accent
       for keywords, cooler hues for everything else. All five type kinds still
       separate cleanly - blue class, periwinkle italic interface, violet record,
       teal struct, pink enum - but nothing shouts. The safest pick for
       eight-hour days.
       Surfaces: editor #101116 / chrome #16181F / panel #13151B
                 raised #272930 / border #2A2B30 / selection #3B3C41
       Text:     #E6E8EF primary, #6B7280 comment, #5E616A gutter
       Types:    class #35C2FF, interface #6E9BFF, record #C084FC,
                 struct #2DD4BF, enum #F472B6
       Syntax:   keyword #FF5C39, method #FBBF24, variable #B4BAC7,
                 operator #FF9E85, string #4ADE80, number #A3E635
       Accent:   #FF5C39

       Generated by gen-themes.py - edit the palette there, not this file. -->
  <Theme Name="Focus Signal" GUID="{c75de096-4883-426b-beab-cfb9ef10843c}" FallbackId="{1ded0138-47ce-435e-84ef-9ec1f439b749}">

    <Category Name="Shell" GUID="{73708ded-2d56-4aad-b8eb-73b20d3f4bff}">
      <Color Name="AccentFillDefault">
        <Background Type="CT_RAW" Source="FFFF5C39"/>
      </Color>
      <Color Name="AccentFillSecondary">
        <Background Type="CT_RAW" Source="E5FF5C39"/>
      </Color>
      <Color Name="AccentFillTertiary">
        <Background Type="CT_RAW" Source="CCFF5C39"/>
      </Color>
      <Color Name="SolidBackgroundFillTertiary">
        <Background Type="CT_RAW" Source="FF272930"/>
      </Color>
      <Color Name="SolidBackgroundFillQuaternary">
        <Background Type="CT_RAW" Source="FF272930"/>
      </Color>
      <Color Name="SurfaceBackgroundFillDefault">
        <Background Type="CT_RAW" Source="FF13151B"/>
      </Color>
      <Color Name="TextFillSecondary">
        <Background Type="CT_RAW" Source="B2E6E8EF"/>
      </Color>
    </Category>

