<Themes>
  <!-- Focus Arcade
       The loudest of the six: four saturated hues at near-equal weight. Nothing
       recedes except comments, which is the point - every token class claims
       its own hue rather than sharing one.
       Surfaces: editor #0D0912 / chrome #150F1C / panel #100B16
                 raised #27202E / border #391226 / selection #3B3641
       Text:     #F2E9FF primary, #6B5E7A comment, #625A6E gutter
       Syntax:   keyword #FF3D7F, type #FFE94E, method #4DA8FF,
                 string #3DFFC9, number #FF9F1C, tag #FFE94E
       Accent:   #FF3D7F

       Generated by gen-themes.py - edit the palette there, not this file. -->
  <Theme Name="Focus Arcade" GUID="{85295a98-be43-456a-8e26-703f5a7742e2}" FallbackId="{1ded0138-47ce-435e-84ef-9ec1f439b749}">

    <Category Name="Shell" GUID="{73708ded-2d56-4aad-b8eb-73b20d3f4bff}">
      <Color Name="AccentFillDefault">
        <Background Type="CT_RAW" Source="FFFF3D7F"/>
      </Color>
      <Color Name="AccentFillSecondary">
        <Background Type="CT_RAW" Source="E5FF3D7F"/>
      </Color>
      <Color Name="AccentFillTertiary">
        <Background Type="CT_RAW" Source="CCFF3D7F"/>
      </Color>
