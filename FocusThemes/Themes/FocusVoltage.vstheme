<Themes>
  <!-- Focus Voltage
       Hot pink keywords against cyan types - the two loudest hues sit at
       opposite ends of the wheel, so structure pops before you read a word.
       Reference types stay cool (cyan class, mint italic interface) and value
       types go warm (lime record, amber struct, orange enum), so the
       cool/warm split alone says what you are looking at.
       Surfaces: editor #090B10 / chrome #0D1017 / panel #0B0E14
                 raised #1D2129 / border #102A31 / selection #32363D
       Text:     #D6E1F2 primary, #5A6A85 comment, #556070 gutter
       Types:    class #3BE8FF, interface #6FFFD1, record #B6FF3D,
                 struct #FFD24D, enum #FF7A1A
       Syntax:   keyword #FF2E88, method #9B8CFF, variable #AEBED6,
                 operator #FF9EC4, string #4ADE80, number #FFF275
       Accent:   #FF2E88

       Generated by gen-themes.py - edit the palette there, not this file. -->
  <Theme Name="Focus Voltage" GUID="{407ed56e-7d85-4ca7-a39c-1a6fe2e1e5c4}" FallbackId="{1ded0138-47ce-435e-84ef-9ec1f439b749}">

    <Category Name="Shell" GUID="{73708ded-2d56-4aad-b8eb-73b20d3f4bff}">
