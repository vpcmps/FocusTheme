<Themes>
  <!-- Focus Reactor
       A green-black ground reads calmer than a blue one, which lets a single
       orange accent carry all the urgency. Aqua types and yellow strings stay
       in one warm-cool pair, so the palette is loud but only three hues wide.
       The design reuses yellow for numbers; numbers take the MACRO red here so
       literals and strings stay distinguishable.
       Surfaces: editor #06100E / chrome #0A1715 / panel #081310
                 raised #1A2926 / border #0C342B / selection #303D3A
       Text:     #D8F3EC primary, #4E6E68 comment, #49665F gutter
       Syntax:   keyword #FF7A1A, type #2EF2C2, method #63D8FF,
                 string #FFE066, number #FF4D6D, tag #2EF2C2
       Accent:   #FF7A1A

       Generated by gen-themes.py - edit the palette there, not this file. -->
  <Theme Name="Focus Reactor" GUID="{a8858c8c-f0f6-4eed-a195-6ef36f084400}" FallbackId="{1ded0138-47ce-435e-84ef-9ec1f439b749}">

    <Category Name="Shell" GUID="{73708ded-2d56-4aad-b8eb-73b20d3f4bff}">
