        "keyword.key"
      ],
      "settings": {
        "foreground": "#AEBED6"
      }
    },
    {
      "name": "Table header",
      "scope": [
        "entity.name.section.toml",
        "entity.name.tag.ini"
      ],
      "settings": {
        "foreground": "#3BE8FF",
        "fontStyle": "bold"
