  "semanticTokenColors": {
    "class": {
      "foreground": "#3BE8FF"
    },
    "interface": {
      "foreground": "#6FFFD1",
      "fontStyle": "italic"
    },
    "struct": {
      "foreground": "#FFD24D"
    },
    "enum": {
      "foreground": "#FF7A1A"
    },
    "enumMember": {
      "foreground": "#AEBED6"
    },
    "type": {
      "foreground": "#3BE8FF"
    },
    "typeParameter": {
      "foreground": "#3BE8FF",
      "fontStyle": "italic"
    },
    "namespace": {
      "foreground": "#5A6A85"
    },
    "*.defaultLibrary": {
      "foreground": "#3BE8FF"
    },
    "function": {
      "foreground": "#9B8CFF"
    },
    "method": {
      "foreground": "#9B8CFF"
    },
    "macro": {
      "foreground": "#9B8CFF"
    },
    "decorator": {
      "foreground": "#9B8CFF"
    },
    "event": {
      "foreground": "#AEBED6"
    },
    "variable": {
      "foreground": "#AEBED6"
    },
    "parameter": {
      "foreground": "#AEBED6"
    },
    "property": {
      "foreground": "#AEBED6"
    },
    "field": {
      "foreground": "#AEBED6"
    },
    "variable.readonly": {
      "foreground": "#FFF275"
    },
    "variable.constant": {
      "foreground": "#FFF275"
    },
    "keyword": {
      "foreground": "#FF2E88"
    },
    "keyword.controlFlow": {
      "foreground": "#FF2E88",
      "fontStyle": "bold"
    },
    "modifier": {
      "foreground": "#FF2E88"
    },
    "operator": {
      "foreground": "#FF9EC4"
    },
    "string": {
      "foreground": "#4ADE80"
    },
    "number": {
      "foreground": "#FFF275"
    },
    "regexp": {
      "foreground": "#2F8551"
    },
    "comment": {
      "foreground": "#5A6A85",
      "fontStyle": "italic"
    },
    "label": {
      "foreground": "#FF2E88"
    },
    "selfKeyword": {
      "foreground": "#FF2E88",
      "fontStyle": "italic"
    },
    "*.deprecated": {
      "foreground": "#556070",
      "fontStyle": "strikethrough"
    }
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5A6A85",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation comment",
      "scope": [
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#5A6A85",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#5A6A85"
      }
    },
    {
      "name": "Plain text",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#D6E1F2"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#FF2E88"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch",
        "keyword.control.exception",
        "keyword.control.return"
      ],
      "settings": {
        "foreground": "#FF2E88",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Import and export",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "meta.import keyword"
      ],
      "settings": {
        "foreground": "#FF2E88"
      }
    },
    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#FF2E88"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "keyword.operator.comparison",
        "keyword.operator.relational",
        "keyword.operator.ternary",
        "keyword.operator.spread",
        "keyword.operator.type.annotation"
      ],
      "settings": {
        "foreground": "#FF9EC4"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string",
        "string.template"
      ],
      "settings": {
        "foreground": "#4ADE80"
      }
    },
    {
      "name": "String interpolation",
      "scope": [
        "meta.template.expression",
        "meta.embedded.line",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#D6E1F2"
      }
    },
    {
      "name": "Escape sequence",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "constant.other.character-class.escape"
      ],
      "settings": {
        "foreground": "#FFF275"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float"
      ],
      "settings": {
        "foreground": "#FFF275"
      }
    },
    {
      "name": "Language constant",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#FFF275"
      }
    },
    {
      "name": "Regex text",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2F8551"
      }
    },
    {
      "name": "Regex group",
      "scope": [
        "punctuation.definition.group.regexp",
        "meta.group.regexp"
      ],
      "settings": {
        "foreground": "#CAD5E4"
      }
    },
    {
      "name": "Regex quantifier and alternation",
      "scope": [
        "keyword.operator.quantifier.regexp",
        "keyword.operator.or.regexp"
      ],
      "settings": {
        "foreground": "#FF2E88"
      }
    },
    {
      "name": "Regex anchor",
      "scope": [
        "keyword.control.anchor.regexp"
      ],
      "settings": {
        "foreground": "#9B8CFF"
      }
    },
    {
      "name": "Regex character class",
      "scope": [
        "constant.other.character-class.regexp",
        "constant.other.character-class.set.regexp"
      ],
      "settings": {
        "foreground": "#FF7A1A"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "entity.name.type.class",
        "entity.name.namespace",
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "#3BE8FF"
      }
    },
    {
      "name": "Interface and trait",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.trait",
        "entity.name.type.protocol"
      ],
      "settings": {
        "foreground": "#6FFFD1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Struct",
      "scope": [
        "entity.name.type.struct",
        "entity.name.type.value"
      ],
      "settings": {
        "foreground": "#FFD24D"
      }
    },
    {
      "name": "Enum",
      "scope": [
        "entity.name.type.enum",
        "entity.name.type.enum-name"
      ],
      "settings": {
        "foreground": "#FF7A1A"
      }
    },
    {
      "name": "Type parameter",
      "scope": [
        "entity.name.type.parameter",
        "entity.name.type.type-parameter",
        "meta.type.parameters entity.name.type"
      ],
      "settings": {
        "foreground": "#3BE8FF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Namespace and module",
      "scope": [
        "entity.name.section",
        "entity.name.type.module",
        "entity.name.type.namespace",
        "support.other.namespace"
      ],
      "settings": {
        "foreground": "#5A6A85"
      }
    },
    {
      "name": "Function and method",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#9B8CFF"
      }
    },
    {
      "name": "Decorator",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.attribute",
        "entity.name.function.attribute"
      ],
      "settings": {
        "foreground": "#9B8CFF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#AEBED6"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#AEBED6"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#AEBED6"
      }
    },
    {
      "name": "Language variable",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "keyword.other.this"
      ],
      "settings": {
        "foreground": "#FF2E88",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF2E88"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#556070",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Tag name",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#3BE8FF"
      }
    },
    {
      "name": "Tag delimiter",
      "scope": [
        "punctuation.definition.tag",
        "punctuation.definition.tag.begin",
        "punctuation.definition.tag.end"
      ],
      "settings": {
        "foreground": "#5A6A85"
      }
    },
    {
      "name": "Attribute name",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute.class",
        "meta.attribute.id"
      ],
      "settings": {
        "foreground": "#AEBED6"
      }
    },
    {
      "name": "Attribute value",
      "scope": [
        "meta.attribute string",
        "string.quoted.double.html",
        "string.quoted.single.html"
      ],
      "settings": {
        "foreground": "#4ADE80"
      }
    },
    {
      "name": "Entity reference",
      "scope": [
        "constant.character.entity"
      ],
      "settings": {
        "foreground": "#FFF275"
      }
    },
    {
      "name": "CSS selector",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#3BE8FF"
      }
    },
    {
      "name": "CSS property",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss",
        "meta.property-name"
      ],
      "settings": {
        "foreground": "#AEBED6"
      }
    },
    {
      "name": "CSS value",
      "scope": [
        "support.constant.property-value",
        "meta.property-value",
        "support.constant.font-name"
      ],
      "settings": {
        "foreground": "#D6E1F2"
      }
    },
    {
      "name": "CSS unit",
      "scope": [
        "keyword.other.unit",
        "constant.numeric.css"
      ],
      "settings": {
        "foreground": "#FFF275"
      }
    },
    {
      "name": "CSS at-rule",
      "scope": [
        "keyword.control.at-rule",
        "punctuation.definition.keyword.css"
      ],
      "settings": {
        "foreground": "#FF2E88"
      }
    },
    {
      "name": "Key",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.toml",
