  "semanticTokenColors": {
    "class": {
      "foreground": "#FF6EC7"
    },
    "interface": {
      "foreground": "#FFB3E3",
      "fontStyle": "italic"
    },
    "struct": {
      "foreground": "#5CFFB1"
    },
    "enum": {
      "foreground": "#FF9060"
    },
    "enumMember": {
      "foreground": "#B7ABD4"
    },
    "type": {
      "foreground": "#FF6EC7"
    },
    "typeParameter": {
      "foreground": "#FF6EC7",
      "fontStyle": "italic"
    },
    "namespace": {
      "foreground": "#6E5A8C"
    },
    "*.defaultLibrary": {
      "foreground": "#FF6EC7"
    },
    "function": {
      "foreground": "#FFD166"
    },
    "method": {
      "foreground": "#FFD166"
    },
    "macro": {
      "foreground": "#FFD166"
    },
    "decorator": {
      "foreground": "#FFD166"
    },
    "event": {
      "foreground": "#B7ABD4"
    },
    "variable": {
      "foreground": "#B7ABD4"
    },
    "parameter": {
      "foreground": "#B7ABD4"
    },
    "property": {
      "foreground": "#B7ABD4"
    },
    "field": {
      "foreground": "#B7ABD4"
    },
    "variable.readonly": {
      "foreground": "#FFF3A3"
    },
    "variable.constant": {
      "foreground": "#FFF3A3"
    },
    "keyword": {
      "foreground": "#C77DFF"
    },
    "keyword.controlFlow": {
      "foreground": "#C77DFF",
      "fontStyle": "bold"
    },
    "modifier": {
      "foreground": "#C77DFF"
    },
    "operator": {
      "foreground": "#E0BFFF"
    },
    "string": {
      "foreground": "#A3FF6B"
    },
    "number": {
      "foreground": "#FFF3A3"
    },
    "regexp": {
      "foreground": "#639746"
    },
    "comment": {
      "foreground": "#6E5A8C",
      "fontStyle": "italic"
    },
    "label": {
      "foreground": "#C77DFF"
    },
    "selfKeyword": {
      "foreground": "#C77DFF",
      "fontStyle": "italic"
    },
    "*.deprecated": {
      "foreground": "#64577D",
      "fontStyle": "strikethrough"
    }
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6E5A8C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation comment",
      "scope": [
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#6E5A8C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#6E5A8C"
      }
    },
    {
      "name": "Plain text",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#E4DAFF"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#C77DFF"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch",
        "keyword.control.exception",
        "keyword.control.return"
      ],
      "settings": {
        "foreground": "#C77DFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Import and export",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "meta.import keyword"
      ],
      "settings": {
        "foreground": "#C77DFF"
      }
    },
    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#C77DFF"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "keyword.operator.comparison",
        "keyword.operator.relational",
        "keyword.operator.ternary",
        "keyword.operator.spread",
        "keyword.operator.type.annotation"
      ],
      "settings": {
        "foreground": "#E0BFFF"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string",
        "string.template"
      ],
      "settings": {
        "foreground": "#A3FF6B"
      }
    },
    {
      "name": "String interpolation",
      "scope": [
        "meta.template.expression",
        "meta.embedded.line",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#E4DAFF"
      }
    },
    {
      "name": "Escape sequence",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "constant.other.character-class.escape"
      ],
      "settings": {
        "foreground": "#FFF3A3"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float"
      ],
      "settings": {
        "foreground": "#FFF3A3"
      }
    },
    {
      "name": "Language constant",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#FFF3A3"
      }
    },
    {
      "name": "Regex text",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#639746"
      }
    },
    {
      "name": "Regex group",
      "scope": [
        "punctuation.definition.group.regexp",
        "meta.group.regexp"
      ],
      "settings": {
        "foreground": "#D0C8E3"
      }
    },
    {
      "name": "Regex quantifier and alternation",
      "scope": [
        "keyword.operator.quantifier.regexp",
        "keyword.operator.or.regexp"
      ],
      "settings": {
        "foreground": "#C77DFF"
      }
    },
    {
      "name": "Regex anchor",
      "scope": [
        "keyword.control.anchor.regexp"
      ],
      "settings": {
        "foreground": "#FFD166"
      }
    },
    {
      "name": "Regex character class",
      "scope": [
        "constant.other.character-class.regexp",
        "constant.other.character-class.set.regexp"
      ],
      "settings": {
        "foreground": "#FF9060"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "entity.name.type.class",
        "entity.name.namespace",
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "#FF6EC7"
      }
    },
    {
      "name": "Interface and trait",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.trait",
        "entity.name.type.protocol"
      ],
      "settings": {
        "foreground": "#FFB3E3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Struct",
      "scope": [
        "entity.name.type.struct",
        "entity.name.type.value"
      ],
      "settings": {
        "foreground": "#5CFFB1"
      }
    },
    {
      "name": "Enum",
      "scope": [
        "entity.name.type.enum",
        "entity.name.type.enum-name"
      ],
      "settings": {
        "foreground": "#FF9060"
      }
    },
    {
      "name": "Type parameter",
      "scope": [
        "entity.name.type.parameter",
        "entity.name.type.type-parameter",
        "meta.type.parameters entity.name.type"
      ],
      "settings": {
        "foreground": "#FF6EC7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Namespace and module",
      "scope": [
        "entity.name.section",
        "entity.name.type.module",
        "entity.name.type.namespace",
        "support.other.namespace"
      ],
      "settings": {
        "foreground": "#6E5A8C"
      }
    },
    {
      "name": "Function and method",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#FFD166"
      }
    },
    {
      "name": "Decorator",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.attribute",
        "entity.name.function.attribute"
      ],
      "settings": {
        "foreground": "#FFD166",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#B7ABD4"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#B7ABD4"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#B7ABD4"
      }
    },
    {
      "name": "Language variable",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "keyword.other.this"
      ],
      "settings": {
        "foreground": "#C77DFF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#C77DFF"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#64577D",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Tag name",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#FF6EC7"
      }
    },
    {
      "name": "Tag delimiter",
      "scope": [
        "punctuation.definition.tag",
        "punctuation.definition.tag.begin",
        "punctuation.definition.tag.end"
      ],
      "settings": {
        "foreground": "#6E5A8C"
      }
    },
    {
      "name": "Attribute name",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute.class",
        "meta.attribute.id"
      ],
      "settings": {
        "foreground": "#B7ABD4"
      }
    },
    {
      "name": "Attribute value",
      "scope": [
        "meta.attribute string",
        "string.quoted.double.html",
        "string.quoted.single.html"
      ],
      "settings": {
        "foreground": "#A3FF6B"
      }
    },
    {
      "name": "Entity reference",
      "scope": [
        "constant.character.entity"
      ],
      "settings": {
        "foreground": "#FFF3A3"
      }
    },
    {
      "name": "CSS selector",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#FF6EC7"
      }
    },
    {
      "name": "CSS property",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss",
        "meta.property-name"
      ],
      "settings": {
        "foreground": "#B7ABD4"
      }
    },
    {
      "name": "CSS value",
      "scope": [
        "support.constant.property-value",
        "meta.property-value",
        "support.constant.font-name"
      ],
      "settings": {
        "foreground": "#E4DAFF"
      }
    },
    {
      "name": "CSS unit",
      "scope": [
        "keyword.other.unit",
        "constant.numeric.css"
      ],
      "settings": {
        "foreground": "#FFF3A3"
      }
    },
    {
      "name": "CSS at-rule",
      "scope": [
        "keyword.control.at-rule",
        "punctuation.definition.keyword.css"
      ],
      "settings": {
        "foreground": "#C77DFF"
      }
    },
    {
      "name": "Key",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.toml",
        "entity.name.tag.yaml",
        "keyword.key"
      ],
      "settings": {
        "foreground": "#B7ABD4"
      }
    },
    {
      "name": "Table header",
      "scope": [
        "entity.name.section.toml",
        "entity.name.tag.ini"
      ],
      "settings": {
        "foreground": "#FF6EC7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "YAML anchor and alias",
      "scope": [
        "entity.name.type.anchor.yaml",
        "variable.other.alias.yaml"
      ],
      "settings": {
        "foreground": "#FFF3A3"
      }
    },
    {
