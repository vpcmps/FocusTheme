    "terminal.ansiBrightRed": "#D59EFF",
    "terminal.ansiGreen": "#A3FF6B",
    "terminal.ansiBrightGreen": "#BAFF90",
    "terminal.ansiYellow": "#FFF3A3",
    "terminal.ansiBrightYellow": "#FFF6BA",
    "terminal.ansiBlue": "#FFD166",
    "terminal.ansiBrightBlue": "#FFDC8C",
    "terminal.ansiMagenta": "#6BE1FF",
    "terminal.ansiBrightMagenta": "#90E8FF",
    "terminal.ansiCyan": "#FF6EC7",
    "terminal.ansiBrightCyan": "#FF92D5",
    "terminal.ansiWhite": "#E4DAFF",
    "terminal.ansiBrightWhite": "#EBE3FF"
